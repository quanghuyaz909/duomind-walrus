# Telegram - from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional: any random string, used to verify webhook calls really come from Telegram
# (only needed when deploying with webhook mode, see README)
TELEGRAM_WEBHOOK_SECRET=

# Optional: protects the daily reminder sweep endpoint. Vercel automatically
# sends this as an Authorization header when set as a Vercel Cron env var.
CRON_SECRET=

# Groq - from console.groq.com (free tier, non-Anthropic/OpenAI model)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Walrus Memory - from memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
